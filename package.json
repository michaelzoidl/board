{
  "name": "useboard",
  "version": "0.1.0",
  "description": "File-based kanban board - folders are columns, markdown files are tasks",
  "type": "module",
  "bin": {
    "board": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:web && tsup",
    "build:cli": "tsup",
    "build:web": "cd web && npm install && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playground": "tsx scripts/playground.ts",
    "link": "npm run build && npm link",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kanban",
    "board",
    "cli",
    "markdown",
    "todo",
    "tasks",
    "project-management",
    "file-based",
    "git-friendly"
  ],
  "author": "Anthropic",
  "license": "MIT",
  "homepage": "https://github.com/anthropics/useboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthropics/useboard.git"
  },
  "bugs": {
    "url": "https://github.com/anthropics/useboard/issues"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "fastify": "^4.28.1",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
